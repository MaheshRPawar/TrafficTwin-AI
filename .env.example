# TrafficTwin AI - Environment Configuration Example
# Copy to .env for local configuration (do not commit .env)

# Environment Mode
TRAFFICTWIN_ENV=development
LOG_LEVEL=INFO

# SUMO Configuration
# Set to your Eclipse SUMO installation directory if not in PATH
SUMO_HOME=

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Operator & Authorization Controls
APPROVAL_MODE=auto
OPERATOR_TOKEN=traffic-operator-local-demo-token

# Corridor Simulation Defaults
DEFAULT_SEED=42
DEFAULT_SCENARIO=normal
