    <!-- Fixed-time safe 2-phase signal plan with yellow and all-red clearance intervals -->
    <!-- Cycle: 30s Main Green + 3s Main Yellow + 2s All Red + 20s Cross Green + 3s Cross Yellow + 2s All Red = 60s -->

    <tlLogic id="J1" type="static" programID="0" offset="0">
