        <phase duration="3"  state="rrrryyyyyrrrryyyyy" name="MAIN_YELLOW"/>
        <phase duration="2"  state="rrrrrrrrrrrrrrrrrr" name="ALL_RED_1"/>
        <phase duration="20" state="GGggrrrrrGGggrrrrr" name="CROSS_GREEN"/>
        <phase duration="3"  state="yyyyrrrrryyyyrrrrr" name="CROSS_YELLOW"/>
        <phase duration="2"  state="rrrrrrrrrrrrrrrrrr" name="ALL_RED_2"/>
