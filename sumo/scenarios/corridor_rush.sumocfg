<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../net/corridor.net.xml"/>
        <route-files value="../routes/corridor_rush.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="360"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <collision.action value="warn"/>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
        <duration-log.disable value="false"/>
    </report>

    <output>
        <tripinfo-output value="../output/tripinfo_rush.xml"/>
        <summary-output value="../output/summary_rush.xml"/>
        <queue-output value="../output/queue_rush.xml"/>
        <fcd-output value="../output/fcd_rush.xml"/>
    </output>
</configuration>
